# ~/.config/arrowbridge/companion.env   (chmod 600). systemd does not expand ~ or $HOME in this
# file: write absolute paths, replacing /home/YOU.
# Loopback only unless you set ARROWBRIDGE_BIND. Set it to the ONE private LAN address of the
# interface your phone shares with this machine. Public, shared-range and wildcard addresses
# are refused and the service exits with status 2.
#ARROWBRIDGE_BIND=192.168.1.20
ARROWBRIDGE_PORT=8788
# Loopback owner listener, used only on a LAN bind (default: port plus one).
#ARROWBRIDGE_OWNER_PORT=8789
ARROWBRIDGE_UPSTREAM_URL=http://127.0.0.1:8080
ARROWBRIDGE_UPSTREAM_MODEL=
# A 0600 file holding the pairing key. Without one a fresh key is generated on every start.
ARROWBRIDGE_PAIR_KEY_FILE=/home/YOU/.config/arrowbridge/pair-key
#ARROWBRIDGE_SYSTEM_PROMPT_FILE=/home/YOU/.config/arrowbridge/system-prompt.txt
#ARROWBRIDGE_MODEL_MAP=name=upstream_model@http://127.0.0.1:8080
#ARROWBRIDGE_DEVICE_NAME=
#ARROWBRIDGE_NO_DISCOVERY=1
